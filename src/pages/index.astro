---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeRenderer from '../components/themes/ThemeRenderer.astro';
import { siteConfig } from '../utils/config';
import type { ThemeName, Language } from '../types/site';

const activeTheme: ThemeName = siteConfig.theme;
const activeLang: Language = siteConfig.defaultLanguage;
const isBioLink = activeTheme === 'bio-link';
---

<BaseLayout
  activeTheme={activeTheme}
  lang={activeLang}
  hideNavbar={isBioLink}
  hideFooter={isBioLink}
>
  <ThemeRenderer theme={activeTheme} lang={activeLang} />
</BaseLayout>

<script is:inline>
  // Instant redirect if visiting with query param ?theme=... in SSG mode
  (function () {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const theme = urlParams.get('theme');
      if (theme) {
        window.location.replace('/preview/' + encodeURIComponent(theme) + window.location.search);
      }
    } catch (e) {}
  })();
</script>
