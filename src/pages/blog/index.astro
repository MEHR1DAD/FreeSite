---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig, formatLocalDate } from '../../utils/config';
import type { Language } from '../../types/site';

const url = Astro.url;
const langParam = url.searchParams.get('lang') as Language | null;
const activeLang: Language = langParam || siteConfig.defaultLanguage;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={activeLang === 'fa' ? 'مقالات و وبلاگ' : 'Articles & Blog'}
  description={activeLang === 'fa' ? 'جدیدترین مقالات، آموزش‌ها و تجربیات مهندسی نرم‌افزار' : 'Latest insights, guides, and engineering articles'}
  lang={activeLang}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-12">
    <!-- Header -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        {activeLang === 'fa' ? 'مقالات و دست‌نوشته‌ها' : 'Articles & Writings'}
      </h1>
      <p class="text-slate-400 text-sm sm:text-base">
        {activeLang === 'fa' 
          ? 'یادداشت‌هایی پیرامون توسعه مدرن وب، معماری نرم‌افزار و تجربیات فنی.'
          : 'Thoughts, guides, and insights on modern web engineering and architecture.'}
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sortedPosts.map((post) => (
        <article class="rounded-3xl bg-slate-900 border border-slate-800 overflow-hidden group hover:border-indigo-500/60 transition duration-300 flex flex-col justify-between shadow-xl">
          <div>
            <a href={`/blog/${post.slug}`} class="block overflow-hidden aspect-video bg-slate-950">
              <img
                src={post.data.coverImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
            </a>
            <div class="p-6 space-y-3">
              <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatLocalDate(post.data.pubDate, activeLang)}
                </time>
                <span>•</span>
                <span>{post.data.author}</span>
              </div>

              <h2 class="text-xl font-bold text-white group-hover:text-indigo-400 transition leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="text-slate-400 text-sm line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-2 flex flex-wrap items-center justify-between gap-2 border-t border-slate-800/80">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-slate-800 text-indigo-300 text-xs font-mono">
                  #{tag}
                </span>
              ))}
            </div>
            <a
              href={`/blog/${post.slug}`}
              class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1"
            >
              <span>{activeLang === 'fa' ? 'ادامه مطلب' : 'Read more'}</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
