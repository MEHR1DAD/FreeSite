---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeRenderer from '../../components/themes/ThemeRenderer.astro';
import { siteConfig, THEME_NAMES } from '../../utils/config';
import type { ThemeName, Language } from '../../types/site';

export async function getStaticPaths() {
  const themes = Object.keys(THEME_NAMES) as ThemeName[];
  return themes.map((theme) => ({
    params: { theme },
    props: { themeName: theme },
  }));
}

const { theme } = Astro.params;
const { themeName } = Astro.props;
const currentTheme: ThemeName = (themeName || theme) as ThemeName;

const url = Astro.url;
const langParam = url.searchParams.get('lang') as Language | null;
const activeLang: Language = langParam || siteConfig.defaultLanguage;
const isBioLink = currentTheme === 'bio-link';
---

<BaseLayout
  activeTheme={currentTheme}
  lang={activeLang}
  hideNavbar={isBioLink}
  hideFooter={isBioLink}
>
  <ThemeRenderer currentTheme={currentTheme} theme={currentTheme} lang={activeLang} />
</BaseLayout>
