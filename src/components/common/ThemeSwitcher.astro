---
import { THEME_NAMES, siteConfig } from '../../utils/config';
import type { ThemeName, Language } from '../../types/site';
import Icon from './Icon.astro';

interface Props {
  currentTheme: ThemeName;
  lang: Language;
}

const { currentTheme, lang } = Astro.props;

const personalThemes = Object.entries(THEME_NAMES).filter(
  ([_, info]) => info.category === 'personal'
);

const businessThemes = Object.entries(THEME_NAMES).filter(
  ([_, info]) => info.category === 'business'
);
---

<div id="theme-switcher-container" class="fixed bottom-6 end-6 z-50">
  <!-- Trigger Button -->
  <button
    id="theme-switcher-toggle"
    aria-label="Toggle Theme Preview Drawer"
    class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-indigo-600/90 hover:bg-indigo-500 text-white font-medium text-sm shadow-xl hover:shadow-indigo-500/25 backdrop-blur-md transition-all duration-300 border border-indigo-400/30 group"
  >
    <span class="text-base animate-bounce">🎨</span>
    <span class="hidden sm:inline">
      {lang === 'fa' ? 'پیش‌نمایش قالب‌ها' : 'Themes Preview'}
    </span>
    <span
      id="current-theme-label"
      class="text-xs px-2 py-0.5 rounded-full bg-indigo-950/60 text-indigo-200 border border-indigo-400/20 font-mono"
    >
      {THEME_NAMES[currentTheme]?.[lang === 'fa' ? 'nameFa' : 'nameEn'] || currentTheme}
    </span>
  </button>

  <!-- Drawer Modal -->
  <div
    id="theme-drawer"
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div
      class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full max-h-[85vh] overflow-hidden flex flex-col shadow-2xl"
    >
      <!-- Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span>✨</span>
            <span>{lang === 'fa' ? 'انتخاب و پیش‌نمایش زنده قالب‌ها' : 'Live Themes Preview'}</span>
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            {lang === 'fa' 
              ? 'موتور FreeSite شامل ۱۴ واریانت واکنش‌گرا برای انواع کاربردهای شخصی و شرکتی است.'
              : 'FreeSite includes 14 ultra-fast responsive theme variants for personal & business uses.'}
          </p>
        </div>
        <button
          id="theme-drawer-close"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition"
        >
          ✕
        </button>
      </div>

      <!-- Themes Content List -->
      <div class="p-5 overflow-y-auto space-y-6">
        <!-- Personal Themes -->
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">
              {lang === 'fa' ? 'قالب‌های شخصی و پورتفولیو (۱۰ واریانت)' : 'Personal & Portfolio Themes (10 variants)'}
            </span>
            <div class="h-px flex-1 bg-slate-800"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {personalThemes.map(([themeKey, info]) => {
              const isCurrent = currentTheme === themeKey;
              const isDefault = siteConfig.theme === themeKey;
              return (
                <a
                  href={`/?theme=${themeKey}`}
                  data-theme={themeKey}
                  data-theme-name={lang === 'fa' ? info.nameFa : info.nameEn}
                  class={`theme-option-link flex items-center justify-between p-3 rounded-xl border transition-all text-sm cursor-pointer ${
                    isCurrent
                      ? 'bg-indigo-600/20 border-indigo-500 text-indigo-200 shadow-md shadow-indigo-500/10'
                      : 'bg-slate-800/50 border-slate-700/60 hover:bg-slate-800 hover:border-slate-600 text-slate-300'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <span class="text-lg">{info.icon}</span>
                    <span class="font-medium">{lang === 'fa' ? info.nameFa : info.nameEn}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    {isDefault && (
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-700 text-slate-300 font-mono">
                        {lang === 'fa' ? 'پیش‌فرض' : 'Default'}
                      </span>
                    )}
                    <span
                      class="theme-active-badge text-xs px-2 py-0.5 rounded-md bg-indigo-500 text-white font-medium"
                      style={isCurrent ? '' : 'display: none;'}
                    >
                      {lang === 'fa' ? 'فعال' : 'Active'}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Business Themes -->
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
              {lang === 'fa' ? 'قالب‌های شرکتی، خدماتی و کسب‌وکار (۴ واریانت)' : 'Business, Services & SaaS Themes (4 variants)'}
            </span>
            <div class="h-px flex-1 bg-slate-800"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {businessThemes.map(([themeKey, info]) => {
              const isCurrent = currentTheme === themeKey;
              const isDefault = siteConfig.theme === themeKey;
              return (
                <a
                  href={`/?theme=${themeKey}`}
                  data-theme={themeKey}
                  data-theme-name={lang === 'fa' ? info.nameFa : info.nameEn}
                  class={`theme-option-link flex items-center justify-between p-3 rounded-xl border transition-all text-sm cursor-pointer ${
                    isCurrent
                      ? 'bg-emerald-600/20 border-emerald-500 text-emerald-200 shadow-md shadow-emerald-500/10'
                      : 'bg-slate-800/50 border-slate-700/60 hover:bg-slate-800 hover:border-slate-600 text-slate-300'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <span class="text-lg">{info.icon}</span>
                    <span class="font-medium">{lang === 'fa' ? info.nameFa : info.nameEn}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    {isDefault && (
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-700 text-slate-300 font-mono">
                        {lang === 'fa' ? 'پیش‌فرض' : 'Default'}
                      </span>
                    )}
                    <span
                      class="theme-active-badge text-xs px-2 py-0.5 rounded-md bg-emerald-500 text-white font-medium"
                      style={isCurrent ? '' : 'display: none;'}
                    >
                      {lang === 'fa' ? 'فعال' : 'Active'}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/60 flex flex-wrap items-center justify-between gap-3">
        <a
          href="/"
          class="text-xs text-slate-400 hover:text-white underline transition"
        >
          {lang === 'fa' ? '🏠 بازگشت به صفحه اصلی سایت' : '🏠 Back to Default Home'}
        </a>
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition"
        >
          <Icon name="settings" class="w-4 h-4 text-indigo-400" />
          <span>{lang === 'fa' ? 'تنظیم در ادمین (/admin)' : 'Set in /admin'}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('theme-switcher-toggle');
  const drawer = document.getElementById('theme-drawer');
  const closeBtn = document.getElementById('theme-drawer-close');

  function openDrawer() {
    drawer?.classList.remove('opacity-0', 'pointer-events-none');
  }

  function closeDrawer() {
    drawer?.classList.add('opacity-0', 'pointer-events-none');
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });

  // Client-side instant theme switcher click handler
  document.querySelectorAll('.theme-option-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const themeKey = link.getAttribute('data-theme');
      const themeName = link.getAttribute('data-theme-name');
      if (!themeKey) return;

      const container = document.getElementById('all-themes-container');
      if (container) {
        // We are on home page! Switch view instantly in DOM
        e.preventDefault();
        
        document.querySelectorAll('.theme-view').forEach((el) => {
          (el as HTMLElement).style.display = 'none';
        });

        const targetEl = document.getElementById('theme-view-' + themeKey);
        if (targetEl) {
          targetEl.style.display = '';
        }

        // Save preference and update URL
        localStorage.setItem('freesite_preview_theme', themeKey);
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('theme', themeKey);
        window.history.pushState({ theme: themeKey }, '', newUrl.toString());

        // Update UI button badges
        document.querySelectorAll('.theme-option-link').forEach((btn) => {
          const btnTheme = btn.getAttribute('data-theme');
          const badge = btn.querySelector('.theme-active-badge') as HTMLElement | null;
          if (btnTheme === themeKey) {
            btn.classList.add('bg-indigo-600/20', 'border-indigo-500', 'text-indigo-200');
            if (badge) badge.style.display = '';
          } else {
            btn.classList.remove('bg-indigo-600/20', 'border-indigo-500', 'text-indigo-200');
            if (badge) badge.style.display = 'none';
          }
        });

        // Update floating label
        const labelEl = document.getElementById('current-theme-label');
        if (labelEl && themeName) {
          labelEl.textContent = themeName;
        }

        // Smoothly close drawer
        closeDrawer();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });
</script>
