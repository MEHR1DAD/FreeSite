---
import { siteConfig, getLocalizedText } from '../../../utils/config';
import type { Language } from '../../../types/site';
import Icon from '../../common/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { business, services = [], faqs = [], socials } = siteConfig;
---

<div class="space-y-24 py-12 sm:py-20">
  
  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-8">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 text-indigo-300 text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
      <span>{lang === 'fa' ? 'نسخه ۱.۰ اکنون در دسترس است' : 'FreeSite Engine v1.0 is Live'}</span>
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight max-w-4xl mx-auto leading-tight">
      {getLocalizedText(lang, business?.taglineFa, business?.taglineEn)}
    </h1>

    <p class="text-slate-300 text-base sm:text-xl max-w-2xl mx-auto leading-relaxed">
      {getLocalizedText(lang, business?.descriptionFa, business?.descriptionEn)}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
      <a
        href="/admin"
        class="px-8 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-sm shadow-xl shadow-indigo-600/30 transition transform hover:-translate-y-0.5"
      >
        {lang === 'fa' ? 'شروع رایگان با کلودفلر' : 'Get Started for Free'}
      </a>
      <a
        href="https://github.com/MEHR1DAD/FreeSite"
        target="_blank"
        class="px-8 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-bold text-sm border border-slate-800 hover:border-slate-700 transition flex items-center gap-2"
      >
        <Icon name="github" class="w-4 h-4" />
        <span>GitHub</span>
      </a>
    </div>

    <!-- SaaS Dashboard Mockup Container -->
    <div class="pt-8 max-w-5xl mx-auto">
      <div class="rounded-3xl p-3 sm:p-4 bg-slate-900/80 border border-slate-800 shadow-2xl backdrop-blur-xl">
        <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950">
          <div class="bg-slate-900 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            </div>
            <span class="text-xs font-mono text-slate-400">dashboard.freesite.dev</span>
            <div class="w-12"></div>
          </div>
          <img
            src="/images/sample-product-2.svg"
            alt="SaaS Mockup"
            class="w-full h-auto object-cover max-h-[400px]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  {services.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-4xl font-black text-white">
          {lang === 'fa' ? 'ویژگی‌های کلیدی پلتفرم' : 'Engine Highlights & Features'}
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">
          {lang === 'fa' 
            ? 'ترکیب سرعت، زیبایی و مدیریت بدون نیاز به دیتابیس یا هزینه‌های نگهداری سرور.'
            : 'Uniting speed, elegance, and zero-maintenance static architecture.'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((svc) => (
          <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 space-y-4 hover:border-purple-500/50 transition">
            <div class="w-12 h-12 rounded-2xl bg-purple-950/60 border border-purple-800/50 text-purple-400 flex items-center justify-center">
              <Icon name={svc.icon || 'globe'} class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-bold text-white">
              {getLocalizedText(lang, svc.titleFa, svc.titleEn)}
            </h3>
            <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
              {getLocalizedText(lang, svc.descFa, svc.descEn)}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- FAQs Section -->
  {faqs.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-white">
          {lang === 'fa' ? 'سوالات متداول استارتاپ‌ها' : 'Frequently Asked Questions'}
        </h2>
        <p class="text-slate-400 text-sm">
          {lang === 'fa' ? 'همه چیز درباره نحوه راه‌اندازی و سفارشی‌سازی' : 'Everything you need to know about FreeSite.'}
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-6 rounded-2xl bg-slate-900/80 border border-slate-800 text-sm transition">
            <summary class="font-bold text-white cursor-pointer flex items-center justify-between list-none">
              <span>{getLocalizedText(lang, faq.questionFa, faq.questionEn)}</span>
              <span class="text-purple-400 text-lg group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <p class="mt-4 text-slate-300 leading-relaxed border-t border-slate-800 pt-4">
              {getLocalizedText(lang, faq.answerFa, faq.answerEn)}
            </p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="rounded-3xl p-8 sm:p-14 bg-gradient-to-r from-indigo-950 via-slate-900 to-purple-950 border border-indigo-800/50 text-center space-y-6 shadow-2xl">
      <h2 class="text-3xl sm:text-5xl font-black text-white">
        {lang === 'fa' ? 'سایت خود را در کمتر از ۲ دقیقه بسازید' : 'Deploy Your Website in Under 2 Minutes'}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
        {lang === 'fa' 
          ? 'بدون نیاز به کارت اعتباری، سرور یا دانش فنی پیچیده. همین حالا رایگان شروع کنید.'
          : 'Zero hosting fees, zero backend maintenance, and 100% open source forever.'}
      </p>
      <div class="pt-2">
        <a
          href="/admin"
          class="inline-block px-8 py-4 rounded-2xl bg-white text-slate-950 font-bold text-sm hover:bg-slate-100 transition shadow-xl"
        >
          {lang === 'fa' ? 'ورود به پنل مدیریت FreeSite' : 'Open FreeSite Admin'}
        </a>
      </div>
    </div>
  </section>

</div>
