---
import { siteConfig, getLocalizedText } from '../../../utils/config';
import type { Language } from '../../../types/site';
import Icon from '../../common/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { profile, socials, skills = [], experiences = [] } = siteConfig;
---

<div class="relative min-h-screen py-16 sm:py-24 overflow-hidden">
  <!-- Ambient Gradient Background Orbs -->
  <div class="absolute top-10 start-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>
  <div class="absolute top-1/3 end-10 w-96 h-96 bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 start-10 w-96 h-96 bg-pink-600/15 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 space-y-12">
    
    <!-- Hero Glass Card -->
    <div class="glass-panel rounded-3xl p-8 sm:p-12 shadow-2xl backdrop-blur-2xl bg-white/5 border border-white/10">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <div class="relative">
          <div class="absolute -inset-1 bg-gradient-to-tr from-indigo-500 to-pink-500 rounded-3xl blur opacity-70"></div>
          <img
            src={profile.avatar || '/images/avatar.svg'}
            alt={getLocalizedText(lang, profile.nameFa, profile.nameEn)}
            class="relative w-32 h-32 rounded-2xl object-cover border border-white/20 shadow-2xl bg-slate-900"
          />
        </div>

        <div class="flex-1 text-center sm:text-start space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs text-indigo-200">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
            <span>{getLocalizedText(lang, profile.availabilityFa, profile.availabilityEn) || 'Available for projects'}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            {getLocalizedText(lang, profile.nameFa, profile.nameEn)}
          </h1>

          <p class="text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-300">
            {getLocalizedText(lang, profile.titleFa, profile.titleEn)}
          </p>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            {getLocalizedText(lang, profile.bioFa, profile.bioEn)}
          </p>

          <!-- Socials Glass Buttons -->
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-2">
            {socials.email && (
              <a
                href={`mailto:${socials.email}`}
                class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white text-sm font-semibold shadow-lg shadow-indigo-600/30 transition"
              >
                {lang === 'fa' ? 'ارتباط مستقیم' : 'Get in Touch'}
              </a>
            )}
            {socials.github && (
              <a
                href={socials.github}
                target="_blank"
                class="p-2.5 rounded-xl glass-panel text-slate-300 hover:text-white transition"
              >
                <Icon name="github" class="w-5 h-5" />
              </a>
            )}
            {socials.linkedin && (
              <a
                href={socials.linkedin}
                target="_blank"
                class="p-2.5 rounded-xl glass-panel text-slate-300 hover:text-blue-400 transition"
              >
                <Icon name="linkedin" class="w-5 h-5" />
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Skills Glass Grid -->
    {skills.length > 0 && (
      <div class="glass-panel rounded-3xl p-8 backdrop-blur-2xl bg-white/5 border border-white/10">
        <h2 class="text-base font-bold text-white mb-6 flex items-center gap-2">
          <span>✨</span>
          <span>{lang === 'fa' ? 'مهارت‌ها و پشته تخصصی' : 'Skills & Technologies'}</span>
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {skills.map((skill) => (
            <span class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 text-xs sm:text-sm font-medium transition">
              {skill}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Experiences Glass Cards -->
    {experiences.length > 0 && (
      <div class="glass-panel rounded-3xl p-8 backdrop-blur-2xl bg-white/5 border border-white/10 space-y-6">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <span>💼</span>
          <span>{lang === 'fa' ? 'سوابق و تجربیات' : 'Experience Timeline'}</span>
        </h2>
        <div class="space-y-4">
          {experiences.map((exp) => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-2 hover:bg-white/10 transition">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <h3 class="text-base font-bold text-white">
                  {getLocalizedText(lang, exp.roleFa, exp.roleEn)}
                </h3>
                <span class="text-xs px-3 py-1 rounded-full bg-white/10 text-indigo-300 w-fit">
                  {getLocalizedText(lang, exp.periodFa, exp.periodEn)}
                </span>
              </div>
              <p class="text-xs font-bold text-indigo-200">
                {getLocalizedText(lang, exp.companyFa, exp.companyEn)}
              </p>
              <p class="text-sm text-slate-300 leading-relaxed pt-1">
                {getLocalizedText(lang, exp.descFa, exp.descEn)}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</div>
