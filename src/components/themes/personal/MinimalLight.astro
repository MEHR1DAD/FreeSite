---
import { siteConfig, getLocalizedText } from '../../../utils/config';
import type { Language } from '../../../types/site';
import Icon from '../../common/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { profile, socials, skills = [], experiences = [] } = siteConfig;
---

<div class="bg-white text-slate-900 min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <!-- Header / Intro -->
    <header class="pb-16 border-b border-slate-200">
      <div class="flex flex-col sm:flex-row items-start justify-between gap-8">
        <div class="space-y-4 max-w-xl">
          {profile.availabilityFa && (
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>{getLocalizedText(lang, profile.availabilityFa, profile.availabilityEn)}</span>
            </span>
          )}
          <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-950">
            {getLocalizedText(lang, profile.nameFa, profile.nameEn)}
          </h1>
          <p class="text-xl font-medium text-slate-600">
            {getLocalizedText(lang, profile.titleFa, profile.titleEn)}
          </p>
          <p class="text-slate-600 text-base leading-relaxed pt-2">
            {getLocalizedText(lang, profile.bioFa, profile.bioEn)}
          </p>

          <!-- Contact buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-4">
            {socials.email && (
              <a
                href={`mailto:${socials.email}`}
                class="px-5 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white text-sm font-semibold transition"
              >
                {lang === 'fa' ? 'ارسال پیام' : 'Get in touch'}
              </a>
            )}
            {socials.github && (
              <a
                href={socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-800 text-sm font-semibold transition"
              >
                GitHub
              </a>
            )}
          </div>
        </div>

        <img
          src={profile.avatar || '/images/avatar.svg'}
          alt={getLocalizedText(lang, profile.nameFa, profile.nameEn)}
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl object-cover border border-slate-200 shadow-lg bg-slate-100"
        />
      </div>
    </header>

    <!-- Skills Section -->
    {skills.length > 0 && (
      <section class="py-14 border-b border-slate-200">
        <h2 class="text-sm font-mono uppercase tracking-widest text-slate-400 mb-6 font-bold">
          {lang === 'fa' ? 'مهارت‌های تخصصی' : 'Technical Stack'}
        </h2>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="px-3.5 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 text-sm font-mono font-medium">
              {skill}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Experiences -->
    {experiences.length > 0 && (
      <section class="py-14 border-b border-slate-200">
        <h2 class="text-sm font-mono uppercase tracking-widest text-slate-400 mb-8 font-bold">
          {lang === 'fa' ? 'سوابق حرفه‌ای' : 'Career History'}
        </h2>
        <div class="space-y-10">
          {experiences.map((exp) => (
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div class="md:col-span-1">
                <span class="text-xs font-mono text-slate-500 font-semibold">
                  {getLocalizedText(lang, exp.periodFa, exp.periodEn)}
                </span>
              </div>
              <div class="md:col-span-3 space-y-1.5">
                <h3 class="text-lg font-bold text-slate-900">
                  {getLocalizedText(lang, exp.roleFa, exp.roleEn)}
                </h3>
                <p class="text-sm font-semibold text-slate-600">
                  {getLocalizedText(lang, exp.companyFa, exp.companyEn)}
                </p>
                <p class="text-sm text-slate-600 leading-relaxed pt-1">
                  {getLocalizedText(lang, exp.descFa, exp.descEn)}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Location & Direct Link -->
    <section class="py-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-600 text-sm">
      <div>
        {profile.locationFa && (
          <p class="font-medium">
            📍 {getLocalizedText(lang, profile.locationFa, profile.locationEn)}
          </p>
        )}
      </div>
      <div class="flex items-center gap-4">
        {socials.linkedin && (
          <a href={socials.linkedin} target="_blank" class="hover:text-slate-950 font-semibold underline">
            LinkedIn
          </a>
        )}
        {socials.telegram && (
          <a href={socials.telegram} target="_blank" class="hover:text-slate-950 font-semibold underline">
            Telegram
          </a>
        )}
      </div>
    </section>
  </div>
</div>
