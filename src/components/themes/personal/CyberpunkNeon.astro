---
import { siteConfig, getLocalizedText } from '../../../utils/config';
import type { Language } from '../../../types/site';
import Icon from '../../common/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { profile, socials, skills = [], experiences = [] } = siteConfig;
---

<div class="min-h-screen py-16 sm:py-24 bg-slate-950 text-slate-100 relative overflow-hidden">
  <!-- Neon Grid Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative space-y-12">
    
    <!-- Hero Box -->
    <div class="rounded-3xl p-8 sm:p-10 bg-slate-900/90 border-2 border-cyan-400 shadow-[0_0_30px_rgba(6,182,212,0.25)] relative">
      <div class="absolute -top-3.5 end-8 px-3 py-0.5 bg-cyan-400 text-slate-950 font-mono text-xs font-black uppercase tracking-wider rounded">
        SYSTEM // ONLINE
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <div class="relative">
          <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-pink-500 shadow-[0_0_20px_rgba(236,72,153,0.4)]">
            <img
              src={profile.avatar || '/images/avatar.svg'}
              alt={getLocalizedText(lang, profile.nameFa, profile.nameEn)}
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="flex-1 text-center sm:text-start space-y-3">
          <h1 class="text-3xl sm:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-pink-400 to-yellow-300">
            {getLocalizedText(lang, profile.nameFa, profile.nameEn)}
          </h1>

          <p class="text-base sm:text-lg font-mono font-bold text-pink-400">
            &gt; {getLocalizedText(lang, profile.titleFa, profile.titleEn)}
          </p>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
            {getLocalizedText(lang, profile.bioFa, profile.bioEn)}
          </p>

          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-3">
            {socials.email && (
              <a
                href={`mailto:${socials.email}`}
                class="px-5 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black text-sm transition shadow-[0_0_15px_rgba(6,182,212,0.5)] font-mono"
              >
                CONNECT()
              </a>
            )}
            {socials.github && (
              <a
                href={socials.github}
                target="_blank"
                class="px-5 py-2.5 rounded-xl bg-slate-950 border border-pink-500/60 hover:border-pink-400 text-pink-300 font-mono text-sm transition shadow-[0_0_10px_rgba(236,72,153,0.3)]"
              >
                GITHUB.EXE
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Skills Module -->
    {skills.length > 0 && (
      <div class="rounded-3xl p-8 bg-slate-900/80 border-2 border-pink-500/50 shadow-[0_0_20px_rgba(236,72,153,0.15)]">
        <h2 class="text-sm font-mono font-bold text-pink-400 uppercase tracking-widest mb-6 flex items-center gap-2">
          <span>⚡</span>
          <span>{lang === 'fa' ? 'ماژول‌های تخصصی و مهارت‌ها' : 'INSTALLED_MODULES.JSON'}</span>
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {skills.map((skill) => (
            <span class="px-3.5 py-1.5 rounded-lg bg-slate-950 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-bold hover:border-cyan-400 hover:shadow-[0_0_10px_rgba(6,182,212,0.4)] transition">
              #{skill}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Experience Logs -->
    {experiences.length > 0 && (
      <div class="rounded-3xl p-8 bg-slate-900/80 border-2 border-yellow-400/50 shadow-[0_0_20px_rgba(250,204,21,0.15)] space-y-6">
        <h2 class="text-sm font-mono font-bold text-yellow-400 uppercase tracking-widest flex items-center gap-2">
          <span>💾</span>
          <span>{lang === 'fa' ? 'لاگ‌های سوابق کاری' : 'CAREER_LOGS.SYS'}</span>
        </h2>
        <div class="space-y-4">
          {experiences.map((exp) => (
            <div class="p-5 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <h3 class="text-base font-bold text-cyan-300 font-mono">
                  {getLocalizedText(lang, exp.roleFa, exp.roleEn)}
                </h3>
                <span class="text-xs font-mono text-pink-400">
                  {getLocalizedText(lang, exp.periodFa, exp.periodEn)}
                </span>
              </div>
              <p class="text-xs font-semibold text-yellow-300">
                @{getLocalizedText(lang, exp.companyFa, exp.companyEn)}
              </p>
              <p class="text-sm text-slate-300 leading-relaxed pt-1">
                {getLocalizedText(lang, exp.descFa, exp.descEn)}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</div>
