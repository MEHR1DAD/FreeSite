---
import { siteConfig, getLocalizedText } from '../../../utils/config';
import type { Language } from '../../../types/site';
import Icon from '../../common/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { profile, socials, skills = [], experiences = [] } = siteConfig;
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
  <!-- Print Button -->
  <div class="flex justify-end mb-6 print:hidden">
    <button
      onclick="window.print()"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 shadow transition"
    >
      <Icon name="file-text" class="w-4 h-4 text-indigo-400" />
      <span>{lang === 'fa' ? 'چاپ یا ذخیره رزومه (PDF)' : 'Print / Save as PDF'}</span>
    </button>
  </div>

  <!-- Main CV Container -->
  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl space-y-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6 pb-8 border-b border-slate-800">
      <div class="text-center sm:text-start space-y-2">
        <h1 class="text-3xl sm:text-4xl font-black text-white">
          {getLocalizedText(lang, profile.nameFa, profile.nameEn)}
        </h1>
        <p class="text-lg font-bold text-indigo-400">
          {getLocalizedText(lang, profile.titleFa, profile.titleEn)}
        </p>
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-slate-400 pt-2">
          {profile.locationFa && (
            <span>📍 {getLocalizedText(lang, profile.locationFa, profile.locationEn)}</span>
          )}
          {socials.email && (
            <a href={`mailto:${socials.email}`} class="hover:text-white transition">
              ✉️ {socials.email}
            </a>
          )}
          {socials.phone && (
            <span>📞 {socials.phone}</span>
          )}
        </div>
      </div>

      <img
        src={profile.avatar || '/images/avatar.svg'}
        alt={getLocalizedText(lang, profile.nameFa, profile.nameEn)}
        class="w-28 h-28 rounded-2xl object-cover border-2 border-indigo-500/30"
      />
    </div>

    <!-- Summary -->
    <section>
      <h2 class="text-xs font-mono uppercase tracking-widest text-indigo-400 font-bold mb-3">
        {lang === 'fa' ? 'خلاصه سوابق و پروفایل' : 'Professional Summary'}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {getLocalizedText(lang, profile.bioFa, profile.bioEn)}
      </p>
    </section>

    <!-- Experience Timeline -->
    {experiences.length > 0 && (
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-indigo-400 font-bold mb-6">
          {lang === 'fa' ? 'تجربیات کاری و دستاوردها' : 'Work Experience'}
        </h2>
        <div class="space-y-8">
          {experiences.map((exp) => (
            <div class="border-s-2 border-slate-800 ps-6 relative">
              <div class="absolute -start-[7px] top-1.5 w-3 h-3 rounded-full bg-indigo-500 ring-4 ring-slate-900"></div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
                <h3 class="text-base font-bold text-white">
                  {getLocalizedText(lang, exp.roleFa, exp.roleEn)}
                </h3>
                <span class="text-xs font-mono text-indigo-300">
                  {getLocalizedText(lang, exp.periodFa, exp.periodEn)}
                </span>
              </div>
              <p class="text-xs font-bold text-slate-400 mb-2">
                {getLocalizedText(lang, exp.companyFa, exp.companyEn)}
              </p>
              <p class="text-sm text-slate-300 leading-relaxed">
                {getLocalizedText(lang, exp.descFa, exp.descEn)}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Skills & Tools -->
    {skills.length > 0 && (
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-indigo-400 font-bold mb-4">
          {lang === 'fa' ? 'مهارت‌ها و شایستگی‌ها' : 'Skills & Competencies'}
        </h2>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="px-3.5 py-1.5 rounded-lg bg-slate-800 text-slate-200 text-xs font-mono font-medium border border-slate-700">
              {skill}
            </span>
          ))}
        </div>
      </section>
    )}
  </div>
</div>
