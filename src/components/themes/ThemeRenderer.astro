---
import type { ThemeName, Language } from '../../types/site';
import { siteConfig } from '../../utils/config';

// Personal Themes
import MinimalDark from './personal/MinimalDark.astro';
import MinimalLight from './personal/MinimalLight.astro';
import CardBento from './personal/CardBento.astro';
import ResumeCv from './personal/ResumeCv.astro';
import TerminalTech from './personal/TerminalTech.astro';
import Glassmorphism from './personal/Glassmorphism.astro';
import CyberpunkNeon from './personal/CyberpunkNeon.astro';
import AuroraGradient from './personal/AuroraGradient.astro';
import DeveloperPortfolio from './personal/DeveloperPortfolio.astro';
import BioLink from './personal/BioLink.astro';

// Business Themes
import Corporate from './business/Corporate.astro';
import ServicesConsulting from './business/ServicesConsulting.astro';
import ProductShowcase from './business/ProductShowcase.astro';
import StartupSaas from './business/StartupSaas.astro';

interface Props {
  theme?: ThemeName;
  currentTheme?: ThemeName;
  lang?: Language;
}

const { theme, currentTheme, lang = siteConfig.defaultLanguage } = Astro.props;
const activeTheme: ThemeName = (currentTheme || theme || siteConfig.theme) as ThemeName;
---

{activeTheme === 'minimal-dark' && <MinimalDark lang={lang} />}
{activeTheme === 'minimal-light' && <MinimalLight lang={lang} />}
{activeTheme === 'card-bento' && <CardBento lang={lang} />}
{activeTheme === 'resume-cv' && <ResumeCv lang={lang} />}
{activeTheme === 'terminal-tech' && <TerminalTech lang={lang} />}
{activeTheme === 'glassmorphism' && <Glassmorphism lang={lang} />}
{activeTheme === 'cyberpunk-neon' && <CyberpunkNeon lang={lang} />}
{activeTheme === 'aurora-gradient' && <AuroraGradient lang={lang} />}
{activeTheme === 'developer-portfolio' && <DeveloperPortfolio lang={lang} />}
{activeTheme === 'bio-link' && <BioLink lang={lang} />}

{activeTheme === 'corporate' && <Corporate lang={lang} />}
{activeTheme === 'services-consulting' && <ServicesConsulting lang={lang} />}
{activeTheme === 'product-showcase' && <ProductShowcase lang={lang} />}
{activeTheme === 'startup-saas' && <StartupSaas lang={lang} />}
